# Area of Circle
r = float(input("Enter radius: "))
circle = 3.14 * r * r
print("Area of Circle =", circle)

# Area of Rectangle
l = float(input("Enter length: "))
b = float(input("Enter breadth: "))
rectangle = l * b
print("Area of Rectangle =", rectangle)

# Area of Square
s = float(input("Enter side: "))
square = s * s
print("Area of Square =", square)

