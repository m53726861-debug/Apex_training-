class Student:
    def __init__(self, name, age, marks):
        self.name = name
        self.age = age
        self.marks = marks

    def display_details(self):
        print("Name:", self.name)
        print("Age:", self.age)
        print("Marks:", self.marks)


# Creating Objects
student1 = Student("Jaya", 20, 85.5)
student2 = Student("Kavin", 21, 90.0)

student1.display_details()
print()

student2.display_details()